{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [["<", ">"]],
  "autoClosingPairs": [
    { "open": "<", "close": ">" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["<", ">"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*<chapter\\b(?![^>]*\\beid=)",
      "end": "^\\s*<chapter\\b[^>]*\\beid="
    }
  }
}
